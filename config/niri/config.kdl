// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

// The config is split into included files; `include` is positional, so the
// order below is the order the sections are applied in. All of them are
// watched, so the config live-reloads when any file changes.
//
//   input.kdl        keyboard, touchpad, mouse, trackpoint
//   outputs.kdl      per-output settings (mode, scale, position)
//   layout.kdl       gaps, widths, focus ring, border, shadow, struts
//   appearance.kdl   blur, layer rules, animations
//   startup.kdl      environment, spawn-at-startup
//   misc.kdl         hotkey overlay, prefer-no-csd, screenshot path
//   window-rules.kdl per-window rules
//   binds.kdl        key and mouse bindings

include "input.kdl"
include "outputs.kdl"
include "layout.kdl"
include "appearance.kdl"
include "startup.kdl"
include "misc.kdl"
include "window-rules.kdl"
include "binds.kdl"
